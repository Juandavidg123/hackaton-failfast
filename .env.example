# LiveKit Configuration
# Get your credentials from: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Flask Backend Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-here
FLASK_PORT=5000

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com
SUPABASE_DB_URL=postgresql://postgres:password@host:port/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# LLM Provider (Free/Local - Ollama)
# Install Ollama from: https://ollama.ai
# Using llama3 (8B) instead of llama3.2 (3.2B) for better function calling support
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_URL=http://localhost:11434

# Language Configuration
VOICE_LANGUAGE=es

# STT Provider (Deepgram - Free tier available)
# Get your free API key from: https://console.deepgram.com/signup
STT_PROVIDER=deepgram
STT_MODEL=nova-2
STT_LANGUAGE=es
DEEPGRAM_API_KEY=your-deepgram-api-key

# TTS Provider (Cartesia - Free tier available)
# Get your free API key from: https://cartesia.ai
TTS_PROVIDER=cartesia
TTS_VOICE=95856005-0332-41b0-935f-352e296aa0df
TTS_LANGUAGE=es
CARTESIA_API_KEY=your-cartesia-api-key

# Duplicate Detection Configuration
DUPLICATE_SIMILARITY_THRESHOLD=80
